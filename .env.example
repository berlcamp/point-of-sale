# Copy to `.env.local`. These are the app's own variables (read by Next.js).
#
# Google OAuth credentials for the LOCAL Supabase stack do NOT live here — they go in a
# separate `.env` at the repo root, which the Supabase CLI reads for env() substitution
# in supabase/config.toml. See the README's "Local development" section.

# --- Local development (default) -------------------------------------------
# Anon key is the shared local default; print it with `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55521
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# --- Hosted project (deployment) -------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL used for the OAuth redirect (no trailing slash).
# Must be `localhost`, not `127.0.0.1` — see the README.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
